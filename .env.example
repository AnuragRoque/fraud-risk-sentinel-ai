# SentinelStream Environment Configuration Example
# Copy this file to .env before starting services

# Application Settings
ENV=development
LOG_LEVEL=INFO

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_VALIDATED_TOPIC=transactions.validated
KAFKA_SCORED_TOPIC=transactions.scored
KAFKA_ALERT_TOPIC=fraud.alerts
KAFKA_DLQ_TOPIC=deadletter.transactions

# Spark Streaming Configuration
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=/tmp/sentinelstream/checkpoints
SPARK_WATERMARK_MINUTES=10

# ML Model Configuration
MODEL_VERSION=iforest_v1.0.0
MODEL_PATH=models/iforest_v1.0.0.joblib
MODEL_REGISTRY_PATH=models/registry.json

# Hybrid Risk Engine Weights & Thresholds
WEIGHT_RULES=0.35
WEIGHT_ML=0.35
WEIGHT_VELOCITY=0.15
WEIGHT_BEHAVIOR=0.15
RISK_HIGH_THRESHOLD=0.70
RISK_MEDIUM_THRESHOLD=0.40

# Database & Warehouse Configuration
DATABASE_URL=sqlite:///warehouse/sentinelstream.db
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=sentinelstream_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Observability Ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
METRICS_HTTP_PORT=8000
